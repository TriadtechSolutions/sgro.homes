<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\Entity\Webform;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function homes_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
 * Implements hook_preprocess_page().
 *
 * Builds and passes the 'contact_us' webform render array to page.html.twig
 * so it can be embedded inside the Contact Us popup modal without needing
 * the Twig Tweak module.
 */
function homes_preprocess_page(&$variables) {
  // Load the 'contact_us' webform entity (the site's custom contact form).
  $webform = Webform::load('contact_us');

  if ($webform && $webform->isOpen()) {
    $variables['contact_webform'] = \Drupal::service('entity.form_builder')
      ->getForm(\Drupal\webform\Entity\WebformSubmission::create(['webform_id' => 'contact_us']), 'add');
  }
  else {
    $variables['contact_webform'] = [];
  }
}

/**
 * Implements hook_preprocess_block().
 */
function homes_preprocess_block(&$variables) {
  if (($variables['elements']['#id'] ?? '') === 'homes_footerfirst') {
    // Hide field_footer_logo_link from rendering separately as text
    if (isset($variables['content']['field_footer_logo_link'])) {
      $variables['content']['field_footer_logo_link']['#access'] = FALSE;
    }

    // Extract URL from field_footer_logo_link
    $logo_url = '/';
    $block_content = \Drupal\block_content\Entity\BlockContent::load(2);
    if ($block_content && $block_content->hasField('field_footer_logo_link') && !$block_content->get('field_footer_logo_link')->isEmpty()) {
      $logo_url = $block_content->get('field_footer_logo_link')->first()->getUrl()->toString();
    }
    $variables['footer_logo_url'] = $logo_url;
  }
}
