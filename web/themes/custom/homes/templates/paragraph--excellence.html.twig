{#
/**
 * @file
 * Parent Paragraph template: excellence (bundle machine name)
 * Twig auto-discovery: paragraph--excellence.html.twig
 *
 * Design reference: Next.js page.tsx — "What Makes S-Gro Special" section
 *                   (lines 368-477). White bg, centred header, 12-col grid:
 *                   left 4 cols (3 features) | centre 4 cols (arch image) | right 4 cols (3 features)
 *
 * Confirmed fields from DB (paragraphs_item_field_data + paragraph__field_*):
 *   - field_badge_text      string      eyebrow  e.g. "ENGINEERING EXCELLENCE"
 *   - field_heading_text    string_long H2       e.g. "What Makes S-Gro Special"
 *   - field_image           image       centre spotlight arch image (direct file)
 *   - field_excellence_1    entity_ref  left  column → 3 excellence_feature children
 *   - field_excellence_2    entity_ref  right column → 3 excellence_feature children
 *
 * Available variables (standard paragraph template):
 *   - paragraph : Full paragraph entity.
 *   - content   : All rendered paragraph fields.
 */
#}

{# ── Resolve header text ── #}
{% set eyebrow  = paragraph.field_badge_text.value   ?: 'ENGINEERING EXCELLENCE' %}
{% set heading  = paragraph.field_heading_text.value ?: 'What Makes S-Gro Special' %}

{# ── Centre arch image (direct image field, same pattern as about-us) ── #}
{% set centre_img_url = null %}
{% set centre_img_alt = 'Certified Technician' %}
{% if paragraph.field_image.entity %}
  {% set centre_img_url = file_url(paragraph.field_image.entity.uri.value) %}
  {% set centre_img_alt = paragraph.field_image.alt ?: 'Certified Technician' %}
{% endif %}

<section id="excellence" class="excellence-section">
  <div class="excellence-container">

    {# ── Centred Section Header ── #}
    <div class="excellence-header">
      <div class="excellence-eyebrow">{{ eyebrow }}</div>
      <h2 class="excellence-heading">{{ heading }}</h2>
    </div>

    {# ── 3-Column Grid: left features | centre image | right features ── #}
    <div class="excellence-grid">

      {# ── Left Column — field_excellence_1 (3 feature children) ── #}
      <div class="excellence-col excellence-col--left">
        {% if content.field_excellence_1 %}
          {% for key, item in content.field_excellence_1 %}
            {% if key|first != '#' %}
              {{ item }}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

      {# ── Centre Column — Arch Image (girlike-spotlight-arch) ── #}
      <div class="excellence-col excellence-col--centre">
        <div class="excellence-img-wrap">
          <div class="excellence-spotlight-arch">
            {% if centre_img_url %}
              <img
                src="{{ centre_img_url }}"
                alt="{{ centre_img_alt }}"
                class="excellence-spotlight-img"
                loading="lazy"
              >
            {% else %}
              <div class="excellence-img-placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none"
                     stroke="#93c5fd" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      {# ── Right Column — field_excellence_2 (3 feature children) ── #}
      <div class="excellence-col excellence-col--right">
        {% if content.field_excellence_2 %}
          {% for key, item in content.field_excellence_2 %}
            {% if key|first != '#' %}
              {{ item }}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

    </div>{# /excellence-grid #}

  </div>{# /excellence-container #}
</section>
