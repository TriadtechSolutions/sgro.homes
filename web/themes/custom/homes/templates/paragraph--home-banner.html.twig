{#
/**
 * @file
 * Parent Paragraph template for Home Banner (home_banner).
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 */
#}

{% set bg_image_url = file_url(paragraph.field_home_banner_image.entity.uri.value) %}
{% set primary_url = paragraph.field_primary_button_link.0.url %}
{% set primary_title = paragraph.field_primary_button_link.0.title %}
{% set secondary_url = paragraph.field_secondary_button_link.0.title ? paragraph.field_secondary_button_link.0.url : 'tel:+919876543210' %}
{% set secondary_title = paragraph.field_secondary_button_link.0.title ?: 'Call +91 98765 43210' %}

<section class="hero-banner-section position-relative overflow-hidden text-white" style="{% if bg_image_url %}background-image: url('{{ bg_image_url }}');{% endif %}">
  {# Dark Gradient Overlay #}
  <div class="hero-overlay position-absolute inset-0"></div>

  <div class="container position-relative z-index-2 py-5 py-lg-6">
    <div class="row align-items-center">
      <div class="col-12 col-lg-7 col-xl-6 text-start">
        
        {# 1. Top Pill Badge #}
        {% if paragraph.field_badge_text.value %}
          <div class="d-inline-flex align-items-center hero-badge mb-3 mb-md-4">
            <span class="badge-dot"></span>
            <svg class="lightning-icon me-1.5" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <span class="badge-text">
              {{ paragraph.field_badge_text.value }}
            </span>
          </div>
        {% endif %}

        {# 2. Main Title Headline #}
        {% if paragraph.field_heading_text.value %}
          <h1 class="hero-title fw-black mb-3">
            {{ paragraph.field_heading_text.value|replace({'Home Appliance': '<span class="text-accent-blue">Home Appliance</span>'})|raw }}
          </h1>
        {% else %}
          <h1 class="hero-title fw-black mb-3">
            Doorstep <span class="text-accent-blue">Home Appliance</span> Repair &amp; Service
          </h1>
        {% endif %}

        {# 3. Subtitle / Description #}
        {% if content.field_description %}
          <div class="hero-subtitle mb-4">
            {{ content.field_description }}
          </div>
        {% endif %}

        {# 4. Action CTA Buttons #}
        <div class="hero-actions d-flex flex-wrap gap-3 mb-4">
          <a href="{{ primary_url ?: '#book-visit' }}" class="btn btn-hero-primary d-inline-flex align-items-center justify-content-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
              <path d="m9 16 2 2 4-4"/>
            </svg>
            <span>{{ primary_title ?: 'BOOK 90-MIN VISIT' }}</span>
          </a>

          <a href="{{ secondary_url }}" class="btn btn-hero-secondary d-inline-flex align-items-center justify-content-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>{{ secondary_title }}</span>
          </a>
        </div>

        {# 5. Horizontal Divider Line #}
        <hr class="hero-divider my-4">

        {# 6. Child Features Bar (field_feature reference) #}
        {% if content.field_feature %}
          <div class="hero-features-bar d-flex flex-nowrap align-items-center gap-3 gap-md-4">
            {% for key, item in content.field_feature %}
              {% if key|first != '#' %}
                <div class="d-inline-flex align-items-center flex-shrink-0">
                  {{ item }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</section>
