{#
/**
 * @file
 * Parent Paragraph template: about_us (bundle machine name)
 * Twig auto-discovery: paragraph--about-us.html.twig
 *
 * Confirmed fields from node 1 / drush inspection:
 *  - field_badge_text          string        e.g. "S-GRO HOME TECH"
 *  - field_heading_text        string_long   e.g. "A PRECISION DOORSTEP SERVICE"
 *  - field_description         text_long     body rich text
 *  - field_image               image         direct image field (not media)
 *  - field_title               string        steps sub-heading "How We Service"
 *  - field_primary_button_link link          CTA button
 *  - field_feature             entity_reference_revisions → about_us_feature children
 */
#}

{# ── Resolve fields ── #}
{% set badge_text  = paragraph.field_badge_text.value  ?: 'S-GRO HOME TECH' %}
{% set heading     = paragraph.field_heading_text.value ?: 'A PRECISION DOORSTEP SERVICE' %}
{% set steps_label = paragraph.field_title.value        ?: 'How We Service' %}

{% set btn_url   = paragraph.field_primary_button_link.0.url   ?: '#book-visit' %}
{% set btn_title = paragraph.field_primary_button_link.0.title ?: 'Schedule Your Inspection' %}

{# Direct image field (field_image is an image, NOT a media entity) #}
{% set image_url = null %}
{% if paragraph.field_image.entity %}
  {% set image_url = file_url(paragraph.field_image.entity.uri.value) %}
  {% set image_alt = paragraph.field_image.alt ?: 'Precision Appliance Diagnostics' %}
{% else %}
  {% set image_alt = 'Precision Appliance Diagnostics' %}
{% endif %}

<section id="about" class="about-section">
  <div class="about-container">
    <div class="about-grid">

      {# ── LEFT — Spotlight Arch Image ── #}
      <div class="about-image-col">
        <div class="about-image-wrap">
          <div class="about-spotlight-arch">
            {% if image_url %}
              <img
                src="{{ image_url }}"
                alt="{{ image_alt }}"
                class="about-spotlight-img"
              >
            {% else %}
              <div class="about-spotlight-placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      {# ── RIGHT — Content Column ── #}
      <div class="about-content-col">

        {# Eyebrow label (field_badge_text) #}
        <div class="about-eyebrow">{{ badge_text }}</div>

        {# Main heading (field_heading_text) #}
        <h2 class="about-heading">{{ heading }}</h2>

        {# Body description (field_description) #}
        {% if content.field_description %}
          <div class="about-body">{{ content.field_description }}</div>
        {% endif %}

        {# ── Steps block — uses field_title + field_feature children ── #}
        <div class="about-steps-wrap">
          <h4 class="about-steps-heading">{{ steps_label }}</h4>

          {% if content.field_feature %}
            <div class="about-steps-list">
              {% for key, item in content.field_feature %}
                {% if key|first != '#' %}
                  {{ item }}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {# ── CTA Button (field_primary_button_link) ── #}
        <div class="about-cta-wrap">
          <a href="{{ btn_url }}" class="btn-hero-primary about-cta-btn">
            {{ btn_title }}
          </a>
        </div>

      </div>{# /about-content-col #}

    </div>{# /about-grid #}
  </div>{# /about-container #}
</section>
