{#
/**
* @file
* Custom Homes theme page.html.twig implementation replicating Next.js header layout.
*/
#}

<div id="page-wrapper">
  <div id="page">

    {# 1. Top Announcement Marquee Ticker Bar #}
    <div class="sgro-topbar">
      <div class="marquee-container flex items-center">
        <div class="marquee-track-left">
          <span class="ticker-item"><span class="marquee-bullet">•</span>⚡ USE CODE SGRO10 TO GET ₹100 OFF ON YOUR FIRST
            SERVICE BOOKING</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>90-MINUTE DOORSTEP ARRIVAL GUARANTEE ACROSS
            COIMBATORE, TAMIL NADU & SURROUNDING DISTRICTS</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>100% GENUINE OEM SPARE PARTS WITH UP TO 180-DAY
            WARRANTY</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>DIRECT HELPLINE: +91 98765 43210 / +91 91234
            56789</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>CERTIFIED TECHNICIANS FOR LG, SAMSUNG,
            WHIRLPOOL, BOSCH, VOLTAS & MORE</span>
        </div>
        <div class="marquee-track-left" aria-hidden="true">
          <span class="ticker-item"><span class="marquee-bullet">•</span>⚡ USE CODE SGRO10 TO GET ₹100 OFF ON YOUR FIRST
            SERVICE BOOKING</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>90-MINUTE DOORSTEP ARRIVAL GUARANTEE ACROSS
            COIMBATORE, TAMIL NADU & SURROUNDING DISTRICTS</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>100% GENUINE OEM SPARE PARTS WITH UP TO 180-DAY
            WARRANTY</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>DIRECT HELPLINE: +91 98765 43210 / +91 91234
            56789</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>CERTIFIED TECHNICIANS FOR LG, SAMSUNG,
            WHIRLPOOL, BOSCH, VOLTAS & MORE</span>
        </div>
      </div>
    </div>

    {# 2. Main Header & Navbar #}
    <header class="sgro-header sticky-top">
      <nav class="navbar navbar-expand-lg navbar-homes py-0">
        <div class="container max-w-7xl mx-auto px-4 sm:px-6 h-20 sm:h-24 flex items-center justify-between w-100">

          {# Left: Brand Logo Region #}
          {% if page.header %}
          <div class="navbar-brand d-flex align-items-center me-auto me-lg-4 py-0">
            {{ page.header }}
          </div>
          {% endif %}

          {# Right Header Actions (Desktop & Mobile Header) #}
          <div
            class="header-action-buttons header-action-container d-flex align-items-center gap-2 gap-sm-3 ms-auto ms-lg-0 order-lg-3">
            {# Phone Hotline (Hidden on small mobile screens <576px) #} <a href="tel:+919876543210"
              class="btn btn-hotline d-none d-sm-inline-flex align-items-center gap-2" title="Call Helpline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>+91 98765 43210</span>
              </a>

              {# Book Visit CTA Button #}
              <a href="#book-visit" class="btn btn-book-visit d-inline-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                  <path d="m9 16 2 2 4-4" />
                </svg>
                <span>BOOK VISIT</span>
              </a>

              {# Mobile Hamburger Toggler Icon #}
              <button class="navbar-toggler border-0 p-2 text-slate-800 shadow-none d-lg-none" id="homes-mobile-toggler"
                type="button" aria-controls="HomesCollapsingNavbar" aria-expanded="false"
                aria-label="Toggle navigation">
                <svg class="hamburger-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e293b"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="4" y1="6" x2="20" y2="6"></line>
                  <line x1="4" y1="12" x2="20" y2="12"></line>
                  <line x1="4" y1="18" x2="20" y2="18"></line>
                </svg>
                <svg class="hamburger-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none"
                  stroke="#1e293b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                  style="display: none;">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
          </div>

          {# Center: Primary Navigation Menu & Mobile Drawer Content #}
          <div class="collapse navbar-collapse justify-content-center order-lg-2" id="HomesCollapsingNavbar">
            {% if page.primary_menu %}
            <div class="primary-menu-container mx-auto">
              {{ page.primary_menu }}
            </div>
            {% endif %}

            {# Mobile Drawer Action Buttons (Full width on mobile drawer) #}
            <div class="mobile-drawer-actions d-lg-none mt-4 pt-3 border-top border-slate-200 d-flex flex-column gap-2">
              <a href="tel:+919876543210"
                class="btn btn-hotline-mobile w-100 d-flex align-items-center justify-content-center gap-2 py-3 rounded-pill bg-light text-dark font-extrabold text-xs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>Call: +91 98765 43210</span>
              </a>

              <a href="#book-visit"
                class="btn btn-book-visit-mobile w-100 d-flex align-items-center justify-content-center gap-2 py-3 rounded-pill bg-primary text-white font-black text-xs uppercase tracking-wider shadow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                  <path d="m9 16 2 2 4-4" />
                </svg>
                <span>Book 90-Min Visit</span>
              </a>
            </div>
          </div>

        </div>
      </nav>
    </header>

    {# Highlighted / Messages Region #}
    {% if page.highlighted %}
    <div class="highlighted-region container">
      {{ page.highlighted }}
    </div>
    {% endif %}

    {# Main Content Region #}
    <main id="main-content" role="main" class="main-container w-100 p-0 m-0">
      {{ page.content }}
    </main>

    {# Footer Region #}
    {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth or page.footer_fifth %}
    <footer class="site-footer-wrapper pt-5 pb-4 mt-auto">
      <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
        <div class="row footer-main-grid gx-lg-5 gy-4 pb-4">
          {% if page.footer_first %}
          <div class="col-lg-4 col-md-6 mb-4 mb-lg-0 footer-col footer-col-first">{{ page.footer_first }}</div>
          {% endif %}
          {% if page.footer_second %}
          <div class="col-lg-3 col-md-6 mb-4 mb-lg-0 footer-col footer-col-second">{{ page.footer_second }}</div>
          {% endif %}
          {% if page.footer_third %}
          <div class="col-lg-2 col-md-6 mb-4 mb-lg-0 footer-col footer-col-third">{{ page.footer_third }}</div>
          {% endif %}
          {% if page.footer_fourth %}
          <div class="col-lg-3 col-md-6 mb-4 mb-lg-0 footer-col footer-col-fourth">{{ page.footer_fourth }}</div>
          {% endif %}
        </div>
        {% if page.footer_fifth %}
        <div class="footer-bottom-bar pt-4 text-center text-sm-start">
          {{ page.footer_fifth }}
        </div>
        {% else %}
        <div class="footer-bottom-bar pt-4 text-center text-sm-start text-xs text-slate-600 font-medium">
          Designed & developed by <a href="https://triadtechsolutions.in/" target="_blank" rel="noopener noreferrer" class="text-slate-900 font-bold hover:text-blue-600 transition-colors">TriadTech Solutions</a>
        </div>
        {% endif %}
      </div>
    </footer>
    {% endif %}

    {# Floating Quick Action Hotline & WhatsApp Buttons #}
    <div class="sgro-floating-actions">
      {# Floating Phone Call Button #}
      <a href="tel:+919876543210" class="floating-btn floating-btn--call" title="Call Helpline" aria-label="Call Helpline">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="floating-tooltip">Call: +91 98765 43210</span>
      </a>

      {# Floating WhatsApp Button #}
      <a href="https://wa.me/919876543210?text=Hi%20S-Gro%20Pvt.%20Ltd.%2C%20I%20need%20doorstep%20appliance%20repair%20support." target="_blank" rel="noopener noreferrer" class="floating-btn floating-btn--whatsapp" title="Chat on WhatsApp" aria-label="Chat on WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#ffffff">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c0-5.445 4.43-9.874 9.877-9.874 2.637 0 5.116 1.028 6.98 2.894a9.81 9.81 0 012.887 6.98c0 5.447-4.431 9.877-9.87 9.877"/>
        </svg>
        <span class="status-pulse-badge">
          <span class="status-pulse-ping"></span>
          <span class="status-pulse-dot"></span>
        </span>
        <span class="floating-tooltip">Instant WhatsApp Chat</span>
      </a>
    </div>

  </div>
</div>