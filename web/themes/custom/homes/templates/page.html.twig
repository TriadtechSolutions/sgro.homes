{#
/**
 * @file
 * Custom Homes theme page.html.twig implementation replicating Next.js header layout.
 */
#}

<div id="page-wrapper">
  <div id="page">

    {# 1. Top Announcement Marquee Ticker Bar #}
    <div class="sgro-topbar">
      <div class="marquee-container flex items-center">
        <div class="marquee-track-left">
          <span class="ticker-item"><span class="marquee-bullet">•</span>⚡ USE CODE SGRO10 TO GET ₹100 OFF ON YOUR FIRST SERVICE BOOKING</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>90-MINUTE DOORSTEP ARRIVAL GUARANTEE ACROSS COIMBATORE, TAMIL NADU & SURROUNDING DISTRICTS</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>100% GENUINE OEM SPARE PARTS WITH UP TO 180-DAY WARRANTY</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>DIRECT HELPLINE: +91 98765 43210 / +91 91234 56789</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>CERTIFIED TECHNICIANS FOR LG, SAMSUNG, WHIRLPOOL, BOSCH, VOLTAS & MORE</span>
        </div>
        <div class="marquee-track-left" aria-hidden="true">
          <span class="ticker-item"><span class="marquee-bullet">•</span>⚡ USE CODE SGRO10 TO GET ₹100 OFF ON YOUR FIRST SERVICE BOOKING</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>90-MINUTE DOORSTEP ARRIVAL GUARANTEE ACROSS COIMBATORE, TAMIL NADU & SURROUNDING DISTRICTS</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>100% GENUINE OEM SPARE PARTS WITH UP TO 180-DAY WARRANTY</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>DIRECT HELPLINE: +91 98765 43210 / +91 91234 56789</span>
          <span class="ticker-item"><span class="marquee-bullet">•</span>CERTIFIED TECHNICIANS FOR LG, SAMSUNG, WHIRLPOOL, BOSCH, VOLTAS & MORE</span>
        </div>
      </div>
    </div>

    {# 2. Main Header & Navbar #}
    <header class="sgro-header sticky-top">
      <nav class="navbar navbar-expand-lg navbar-homes py-0">
        <div class="container max-w-7xl mx-auto px-4 sm:px-6 h-20 sm:h-24 flex items-center justify-between w-100">

          {# Left: Brand Logo Region #}
          {% if page.header %}
            <div class="navbar-brand d-flex align-items-center me-auto me-lg-4 py-0">
              {{ page.header }}
            </div>
          {% endif %}

          {# Right Header Actions (Desktop & Mobile Header) #}
          <div class="header-action-buttons header-action-container d-flex align-items-center gap-2 gap-sm-3 ms-auto ms-lg-0 order-lg-3">
            {# Phone Hotline (Hidden on small mobile screens <576px) #}
            <a href="tel:+919876543210" class="btn btn-hotline d-none d-sm-inline-flex align-items-center gap-2" title="Call Helpline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>+91 98765 43210</span>
            </a>

            {# Book Visit CTA Button #}
            <a href="#book-visit" class="btn btn-book-visit d-inline-flex align-items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
                <path d="m9 16 2 2 4-4"/>
              </svg>
              <span>BOOK VISIT</span>
            </a>

            {# Mobile Hamburger Toggler Icon #}
            <button class="navbar-toggler border-0 p-2 text-slate-800 shadow-none d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#HomesCollapsingNavbar" aria-controls="HomesCollapsingNavbar" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
          </div>

          {# Center: Primary Navigation Menu & Mobile Drawer Content #}
          <div class="collapse navbar-collapse justify-content-center order-lg-2" id="HomesCollapsingNavbar">
            {% if page.primary_menu %}
              <div class="primary-menu-container mx-auto">
                {{ page.primary_menu }}
              </div>
            {% endif %}

            {# Mobile Drawer Action Buttons (Full width on mobile drawer) #}
            <div class="mobile-drawer-actions d-lg-none mt-4 pt-3 border-top border-slate-200 d-flex flex-column gap-2">
              <a href="tel:+919876543210" class="btn btn-hotline-mobile w-100 d-flex align-items-center justify-content-center gap-2 py-3 rounded-pill bg-light text-dark font-extrabold text-xs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>Call: +91 98765 43210</span>
              </a>

              <a href="#book-visit" class="btn btn-book-visit-mobile w-100 d-flex align-items-center justify-content-center gap-2 py-3 rounded-pill bg-primary text-white font-black text-xs uppercase tracking-wider shadow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                  <path d="m9 16 2 2 4-4"/>
                </svg>
                <span>Book 90-Min Visit</span>
              </a>
            </div>
          </div>

        </div>
      </nav>
    </header>

    {# Highlighted / Messages Region #}
    {% if page.highlighted %}
      <div class="highlighted-region container mt-3">
        {{ page.highlighted }}
      </div>
    {% endif %}

    {# Main Content Region #}
    <main id="main-content" role="main" class="main-container container my-4">
      <div class="row">
        <div class="col-12">
          {{ page.content }}
        </div>
      </div>
    </main>

    {# Footer Region #}
    {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth or page.footer_fifth %}
      <footer class="site-footer bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container">
          <div class="row">
            {% if page.footer_first %}
              <div class="col-md-3">{{ page.footer_first }}</div>
            {% endif %}
            {% if page.footer_second %}
              <div class="col-md-3">{{ page.footer_second }}</div>
            {% endif %}
            {% if page.footer_third %}
              <div class="col-md-3">{{ page.footer_third }}</div>
            {% endif %}
            {% if page.footer_fourth %}
              <div class="col-md-3">{{ page.footer_fourth }}</div>
            {% endif %}
          </div>
          {% if page.footer_fifth %}
            <div class="border-top border-secondary mt-4 pt-3 text-center">
              {{ page.footer_fifth }}
            </div>
          {% endif %}
        </div>
      </footer>
    {% endif %}

  </div>
</div>
